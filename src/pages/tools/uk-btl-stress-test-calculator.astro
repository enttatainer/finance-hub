---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="UK Buy-to-Let Stress Test Calculator" description="Test your rental property against interest rate hikes and tenant defaults.">
  <main class="container">
    <h1>UK BTL Stress Test Calculator</h1>
    <p class="subtitle">See if your rental property survives the worst-case scenario.</p>

    <div class="calc-box">
      <div class="input-group">
        <label>Total Mortgage Amount (£)</label>
        <input type="number" id="mortgage" placeholder="e.g. 430000" />
      </div>
      <div class="input-group">
        <label>Current Interest Rate (%)</label>
        <input type="number" id="rate" placeholder="e.g. 5.0" step="0.1" />
      </div>
      <div class="input-group">
        <label>Remaining Term (Years)</label>
        <input type="number" id="term" placeholder="e.g. 13" />
      </div>
      <div class="input-group">
        <label>Expected Monthly Rent (£)</label>
        <input type="number" id="rent" placeholder="e.g. 3000" />
      </div>
      <div class="input-group">
        <label>Monthly Expenses (Maintenance, Insurance, Voids) (£)</label>
        <input type="number" id="expenses" placeholder="e.g. 300" />
      </div>
      <button id="calcBtn">Run Stress Test</button>
      
      <div id="result" class="hidden result-box">
        <p class="total">Base Monthly Cashflow: <strong id="baseCashflow"></strong></p>
        <p class="sub" style="color: #dc2626; font-weight: bold;">Stress Test 1 (Rent drops 20%): <span id="rentStress"></span></p>
        <p class="sub" style="color: #dc2626; font-weight: bold;">Stress Test 2 (Interest Rates +2%): <span id="rateStress"></span></p>
        <p class="sub" style="color: #dc2626; font-weight: bold;">Worst Case (Both happen): <span id="worstCase"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>Why You Need a Stress Test</h2>
      <p>When you buy a Buy-to-Let property, the bank will do a stress test, but they usually only care about their own risk. You should care about yours.</p>
      <p>A stress test simulates what happens if your rental income drops (due to a bad tenant or a void period) or if interest rates spike when your fixed term ends. If you cannot cover the mortgage in the "Worst Case" scenario from your own salary, the investment is too risky.</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const mortgage = parseFloat(document.getElementById('mortgage').value);
    const rate = parseFloat(document.getElementById('rate').value) / 100 / 12;
    const term = parseFloat(document.getElementById('term').value) * 12;
    const rent = parseFloat(document.getElementById('rent').value);
    const expenses = parseFloat(document.getElementById('expenses').value) || 0;

    if (isNaN(mortgage) || isNaN(rate) || isNaN(term) || isNaN(rent)) {
      alert("Please fill in all fields correctly.");
      return;
    }

    const x = Math.pow(1 + rate, term);
    const monthlyPayment = (mortgage * x * rate) / (x - 1);

    // Base Case
    const baseCashflow = rent - monthlyPayment - expenses;

    // Stress 1: Rent drops 20% (bad tenant / void)
    const stressedRent = rent * 0.8;
    const rentStress = stressedRent - monthlyPayment - expenses;

    // Stress 2: Interest rates + 2%
    const stressedRate = (parseFloat(document.getElementById('rate').value) + 2) / 100 / 12;
    const xStress = Math.pow(1 + stressedRate, term);
    const stressedPayment = (mortgage * xStress * stressedRate) / (xStress - 1);
    const rateStress = rent - stressedPayment - expenses;

    // Worst Case: Both happen
    const worstCase = stressedRent - stressedPayment - expenses;

    // Function to format currency
    const fmt = (num) => (num < 0 ? "-£" : "£") + Math.abs(num).toFixed(2);

    document.getElementById('baseCashflow').innerText = fmt(baseCashflow);
    document.getElementById('rentStress').innerText = fmt(rentStress);
    document.getElementById('rateStress').innerText = fmt(rateStress);
    document.getElementById('worstCase').innerText = fmt(worstCase);
    
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 18px; margin: 0 0 8px 0; font-weight: bold; } .sub { font-size: 14px; color: #4b5563; margin: 6px 0; display: flex; justify-content: space-between; }
  .article-content { margin-top: 40px; line-height: 1.6; }
  .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
