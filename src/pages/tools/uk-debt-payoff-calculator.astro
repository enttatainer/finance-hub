---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="UK Debt Payoff Calculator | Snowball & Avalanche" description="Calculate how long it will take to pay off your credit card debt and how much interest you can save.">
  <main class="container">
    <h1>UK Debt Payoff Calculator</h1>
    <p class="subtitle">See your debt-free date and the true cost of your interest.</p>

    <div class="calc-box">
      <div class="input-group">
        <label>Current Total Debt (£)</label>
        <input type="number" id="debt" placeholder="e.g. 6000" />
      </div>
      <div class="input-group">
        <label>Average Interest Rate (APR %)</label>
        <input type="number" id="apr" placeholder="e.g. 22.9" step="0.1" />
      </div>
      <div class="input-group">
        <label>Monthly Payment (£)</label>
        <input type="number" id="payment" placeholder="e.g. 300" />
      </div>
      <button id="calcBtn">Calculate Payoff</button>
      
      <div id="result" class="hidden result-box">
        <p class="total">Time to Payoff: <strong id="timeToPayoff"></strong></p>
        <p class="sub">Total Interest Paid: <span id="totalInterest" style="color: #dc2626;"></span></p>
        <p class="sub">Debt-Free Date: <span id="date" style="color: #16a34a; font-weight: bold;"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>The Math of Debt</h2>
      <p>Credit card debt is the most expensive money you will ever borrow. With average APRs hovering around 20-25%, compound interest works against you at a terrifying speed.</p>
      <p>If you only pay the minimum balance, the bank will keep you in debt for decades. This calculator shows you exactly how much interest you are paying, and how making a fixed, higher monthly payment can speed up your journey to zero.</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const debt = parseFloat(document.getElementById('debt').value);
    const apr = parseFloat(document.getElementById('apr').value) / 100 / 12; // Monthly rate
    const payment = parseFloat(document.getElementById('payment').value);

    if (isNaN(debt) || isNaN(apr) || isNaN(payment) || payment <= 0) {
      alert("Please enter valid numbers.");
      return;
    }

    let balance = debt;
    let months = 0;
    let totalInterest = 0;

    while (balance > 0 && months < 1200) { // 100 year safety break
      const interest = balance * apr;
      if (payment <= interest) {
        alert("Your monthly payment is too low to ever pay off the interest. Increase your payment.");
        return;
      }
      totalInterest += interest;
      balance = balance + interest - payment;
      months++;
    }

    const years = Math.floor(months / 12);
    const remainingMonths = months % 12;
    
    let timeString = "";
    if (years > 0) timeString += years + " yrs ";
    if (remainingMonths > 0) timeString += remainingMonths + " mos";

    // Calculate Payoff Date
    const date = new Date();
    date.setMonth(date.getMonth() + months);
    const options = { year: 'numeric', month: 'long' };
    const dateString = date.toLocaleDateString('en-GB', options);

    const fmt = (num) => "£" + num.toLocaleString('en-GB', {minimumFractionDigits: 2, maximumFractionDigits: 2});

    document.getElementById('timeToPayoff').innerText = timeString;
    document.getElementById('totalInterest').innerText = fmt(totalInterest);
    document.getElementById('date').innerText = dateString;
    
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 18px; margin: 0 0 8px 0; font-weight: bold; } .sub { font-size: 14px; color: #4b5563; margin: 4px 0; display: flex; justify-content: space-between; }
  .article-content { margin-top: 40px; line-height: 1.6; }
  .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
