---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Airbnb / Rental Property ROI Calculator" description="Calculate your cash-on-cash return and cap rate for short-term or long-term rentals.">
  <main class="container">
    <h1>Rental Property ROI Calculator</h1>
    <p class="subtitle">Analyze the profitability of a rental investment.</p>

    <div class="calc-box">
      <div class="input-group"><label>Property Purchase Price ($)</label><input type="number" id="price" placeholder="e.g. 250000" /></div>
      <div class="input-group"><label>Expected Monthly Rental Income ($)</label><input type="number" id="rent" placeholder="e.g. 2000" /></div>
      <div class="input-group"><label>Monthly Expenses (Mortgage, Tax, Insurance) ($)</label><input type="number" id="expenses" placeholder="e.g. 1200" /></div>
      <button id="calcBtn">Calculate ROI</button>
      <div id="result" class="hidden result-box">
        <p class="total">Cash-on-Cash Return: <strong id="roi"></strong></p>
        <p class="sub">Annual Cash Flow: <span id="cashFlow"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>What is Cash-on-Cash Return?</h2>
      <p>Cash-on-Cash return is a simple metric used by real estate investors. It measures the annual pre-tax cash flow generated by the property divided by the total cash invested (the purchase price). A good cash-on-cash return is typically between 8% and 12%, depending on the market.</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const price = parseFloat(document.getElementById('price').value);
    const rent = parseFloat(document.getElementById('rent').value);
    const exp = parseFloat(document.getElementById('expenses').value);

    if (isNaN(price) || isNaN(rent) || isNaN(exp)) { alert("Fill all fields"); return; }

    const monthlyCashFlow = rent - exp;
    const annualCashFlow = monthlyCashFlow * 12;
    const roi = (annualCashFlow / price) * 100;

    document.getElementById('roi').innerText = roi.toFixed(2) + "%";
    document.getElementById('cashFlow').innerText = "$" + annualCashFlow.toLocaleString('en-US', {minimumFractionDigits: 2});
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 18px; margin: 0 0 8px 0; } .sub { font-size: 14px; color: #4b5563; }
  .article-content { margin-top: 40px; line-height: 1.6; } .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
