---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Investment Fee Calculator | Compare Platform Costs" description="See how much platform fees eat into your long-term investment returns.">
  <main class="container">
    <h1>Investment Fee Calculator</h1>
    <p class="subtitle">See how much platform fees eat into your long-term returns.</p>

    <div class="calc-box">
      <div class="input-group">
        <label>Initial Investment (£)</label>
        <input type="number" id="initial" placeholder="e.g. 30000" />
      </div>
      <div class="input-group">
        <label>Monthly Contribution (£)</label>
        <input type="number" id="monthly" placeholder="e.g. 1000" />
      </div>
      <div class="input-group">
        <label>Expected Annual Return (%)</label>
        <input type="number" id="return" placeholder="e.g. 7" step="0.1" />
      </div>
      <div class="input-group">
        <label>Platform A Annual Fee (%)</label>
        <input type="number" id="feeA" placeholder="e.g. 0.15" step="0.01" />
      </div>
      <div class="input-group">
        <label>Platform B Annual Fee (%)</label>
        <input type="number" id="feeB" placeholder="e.g. 0.25" step="0.01" />
      </div>
      <div class="input-group">
        <label>Years Invested</label>
        <input type="number" id="years" placeholder="e.g. 30" />
      </div>
      <button id="calcBtn">Calculate Difference</button>
      
      <div id="result" class="hidden result-box">
        <p class="total">Platform A Final Balance: <strong id="balanceA" style="color: #16a34a;"></strong></p>
        <p class="total">Platform B Final Balance: <strong id="balanceB" style="color: #dc2626;"></strong></p>
        <p class="sub" style="margin-top: 12px; font-weight: bold;">Difference: <span id="difference"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>Why Platform Fees Matter</h2>
      <p>A 0.15% fee sounds insignificant. But compounding works both ways: it magnifies your returns, and it magnifies the fees you pay. A 0.5% fee difference on a growing portfolio can cost you over £50,000 in lost wealth over 30 years.</p>
      <p>Always compare the total cost of ownership: the platform fee + the fund fee (OCF).</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const initial = parseFloat(document.getElementById('initial').value) || 0;
    const monthly = parseFloat(document.getElementById('monthly').value) || 0;
    const returnRate = parseFloat(document.getElementById('return').value) / 100 || 0;
    const feeA = parseFloat(document.getElementById('feeA').value) / 100 || 0;
    const feeB = parseFloat(document.getElementById('feeB').value) / 100 || 0;
    const years = parseFloat(document.getElementById('years').value) || 0;

    if (isNaN(initial) || isNaN(years)) { alert("Please fill in all fields."); return; }

    // Compound function
    const calculateGrowth = (fee) => {
      let balance = initial;
      const monthlyReturn = (returnRate - fee) / 12;
      for (let i = 0; i < years * 12; i++) {
        balance = balance * (1 + monthlyReturn) + monthly;
      }
      return balance;
    };

    const finalA = calculateGrowth(feeA);
    const finalB = calculateGrowth(feeB);
    const diff = Math.abs(finalA - finalB);

    const fmt = (num) => "£" + num.toLocaleString('en-GB', {maximumFractionDigits: 0});

    document.getElementById('balanceA').innerText = fmt(finalA);
    document.getElementById('balanceB').innerText = fmt(finalB);
    document.getElementById('difference').innerText = fmt(diff) + " lost to fees";
    
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 16px; margin: 0 0 8px 0; font-weight: bold; } .sub { font-size: 14px; color: #4b5563; margin: 6px 0; }
  .article-content { margin-top: 40px; line-height: 1.6; }
  .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
