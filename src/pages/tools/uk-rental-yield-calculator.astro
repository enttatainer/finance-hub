---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="UK Buy-to-Let Rental Yield Calculator" description="Calculate the gross and net rental yield of your UK property investment.">
  <main class="container">
    <h1>UK Rental Yield Calculator</h1>
    <p class="subtitle">Analyze your buy-to-let property investment.</p>
    <div class="calc-box">
      <div class="input-group"><label>Property Purchase Price (£)</label><input type="number" id="price" placeholder="e.g. 200000" /></div>
      <div class="input-group"><label>Monthly Rent (£)</label><input type="number" id="rent" placeholder="e.g. 1000" /></div>
      <div class="input-group"><label>Annual Expenses (£)</label><input type="number" id="expenses" placeholder="e.g. 3000" /></div>
      <button id="calcBtn">Calculate Yield</button>
      <div id="result" class="hidden result-box">
        <p class="total">Net Rental Yield: <strong id="netYield"></strong></p>
        <p class="sub">Gross Rental Yield: <span id="grossYield"></span></p>
      </div>
    </div>
    <article class="article-content">
      <h2>What is Rental Yield?</h2>
      <p>Rental yield is the annual return on your investment. Gross yield is simply annual rent divided by the property price. Net yield accounts for your operating expenses (maintenance, insurance, letting fees) and gives a more realistic picture of your profit.</p>
    </article>
  </main>
</Layout>
<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const price = parseFloat(document.getElementById('price').value);
    const rent = parseFloat(document.getElementById('rent').value) * 12;
    const exp = parseFloat(document.getElementById('expenses').value) || 0;
    if (isNaN(price) || isNaN(rent)) { alert("Fill all fields"); return; }

    const grossYield = (rent / price) * 100;
    const netYield = ((rent - exp) / price) * 100;

    document.getElementById('netYield').innerText = netYield.toFixed(2) + "%";
    document.getElementById('grossYield').innerText = grossYield.toFixed(2) + "%";
    document.getElementById('result').classList.remove('hidden');
  });
</script>
<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 18px; margin: 0 0 8px 0; } .sub { font-size: 14px; color: #4b5563; }
  .article-content { margin-top: 40px; line-height: 1.6; } .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
