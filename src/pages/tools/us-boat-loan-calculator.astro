---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Boat Loan Calculator | Estimate Monthly Payments" description="Calculate your monthly boat loan payments, including loan term and interest.">
  <main class="container">
    <h1>Boat Loan Calculator</h1>
    <p class="subtitle">Estimate your monthly payments on a new or used boat.</p>

    <div class="calc-box">
      <div class="input-group">
        <label>Boat Price ($)</label>
        <input type="number" id="price" placeholder="e.g. 45000" />
      </div>
      <div class="input-group">
        <label>Down Payment ($)</label>
        <input type="number" id="down" placeholder="e.g. 5000" />
      </div>
      <div class="input-group">
        <label>Interest Rate (%)</label>
        <input type="number" id="rate" placeholder="e.g. 6.5" step="0.1" />
      </div>
      <div class="input-group">
        <label>Loan Term (Years)</label>
        <input type="number" id="term" placeholder="e.g. 10" />
      </div>
      <button id="calcBtn">Calculate Boat Loan</button>
      <div id="result" class="hidden result-box">
        <p class="total">Monthly Payment: <strong id="monthlyPay"></strong></p>
        <p class="sub">Total Interest Paid: <span id="totalInterest"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>How Boat Loans Work</h2>
      <p>Boat loans are similar to auto loans but often have longer terms (10 to 20 years) because boats are expensive. Interest rates depend on your credit score, the age of the boat, and the loan term. A larger down payment (usually 10-20%) helps secure a better rate.</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const price = parseFloat(document.getElementById('price').value);
    const down = parseFloat(document.getElementById('down').value) || 0;
    const rate = parseFloat(document.getElementById('rate').value) / 100 / 12;
    const term = parseFloat(document.getElementById('term').value) * 12;

    if (isNaN(price) || isNaN(rate) || isNaN(term)) { alert("Fill all fields"); return; }
    const principal = price - down;
    const x = Math.pow(1 + rate, term);
    const monthly = (principal * x * rate) / (x - 1);
    const totalInterest = (monthly * term) - principal;

    document.getElementById('monthlyPay').innerText = "$" + monthly.toFixed(2);
    document.getElementById('totalInterest').innerText = "$" + totalInterest.toFixed(2);
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; margin-bottom: 8px; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; }
  .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; }
  .total { font-size: 18px; margin: 0 0 8px 0; } .sub { font-size: 14px; color: #4b5563; margin: 4px 0; }
  .article-content { margin-top: 40px; line-height: 1.6; }
  .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
