---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="US Property Tax Calculator | Estimate Your Annual Bill" description="Calculate your annual property tax based on the assessed value and local millage rate.">
  <main class="container">
    <h1>US Property Tax Calculator</h1>
    <p class="subtitle">Estimate your annual property tax bill.</p>

    <div class="calc-box">
      <div class="input-group"><label>Property Assessed Value ($)</label><input type="number" id="value" placeholder="e.g. 350000" /></div>
      <div class="input-group"><label>Local Property Tax Rate (%)</label><input type="number" id="rate" placeholder="e.g. 1.2" step="0.01" /></div>
      <button id="calcBtn">Calculate Tax</button>
      <div id="result" class="hidden result-box">
        <p class="total">Annual Property Tax: <strong id="tax"></strong></p>
        <p class="sub">Monthly Estimate: <span id="monthly"></span></p>
      </div>
    </div>

    <article class="article-content">
      <h2>How Property Taxes Work</h2>
      <p>Property taxes are calculated by multiplying the assessed value of your home by the local tax rate (often called a millage rate). The average effective property tax rate in the US is around 1.1%, but it varies wildly by state and county. Some states like Texas have rates over 1.8%, while states like Hawaii have rates below 0.3%.</p>
    </article>
  </main>
</Layout>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const value = parseFloat(document.getElementById('value').value);
    const rate = parseFloat(document.getElementById('rate').value) / 100;

    if (isNaN(value) || isNaN(rate)) { alert("Enter valid numbers"); return; }

    const annualTax = value * rate;

    document.getElementById('tax').innerText = "$" + annualTax.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    document.getElementById('monthly').innerText = "$" + (annualTax / 12).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .container { max-width: 800px; margin: 0 auto; padding: 32px 16px; }
  h1 { text-align: center; } .subtitle { text-align: center; color: #6b7280; margin-bottom: 32px; }
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; } .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; } .total { font-size: 18px; margin: 0 0 8px 0; } .sub { font-size: 14px; color: #4b5563; }
  .article-content { margin-top: 40px; line-height: 1.6; } .article-content h2 { margin-top: 32px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px; }
</style>
