---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Free Finance Calculators | Finance Hub" description="30+ free, accurate financial calculators for US, UK, Canada, and Australia.">
  <main class="container">
    
    <header class="hero">
      <h1>Free Finance Calculators</h1>
      <p>30+ fast, accurate, math-driven tools for your financial planning.</p>
    </header>

    <!-- SEARCH BAR -->
    <div class="search-container">
      <input type="text" id="toolSearch" placeholder="🔍 Search calculators (e.g., mortgage, tax, UK)..." />
      <p id="noResults" class="no-results hidden">No calculators found. Try a different keyword.</p>
    </div>

    <div class="grid" id="toolsGrid">
      
      <!-- ========================================== -->
      <!-- CATEGORY 1: TAX, LOANS & INVESTING         -->
      <!-- ========================================== -->
      <h2 class="category-title">Tax, Loans & Investing</h2>

      <a href="/tools/us-freelancer-tax-calculator" class="card">
        <div class="card-icon">📝</div>
        <h2>US Freelancer Tax (1099)</h2>
        <p>Estimate 2024 Self-Employment and Federal Income taxes.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/us-mortgage-calculator" class="card">
        <div class="card-icon">🏠</div>
        <h2>US Mortgage Calculator</h2>
        <p>Calculate monthly payments, total interest, and amortization.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/compound-interest-calculator" class="card">
        <div class="card-icon">📈</div>
        <h2>Compound Interest</h2>
        <p>See how your investments grow over time with compounding.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/us-car-loan-calculator" class="card">
        <div class="card-icon">🚗</div>
        <h2>US Car Loan Calculator</h2>
        <p>Estimate monthly auto loan payments, including trade-ins.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/salary-to-hourly-calculator" class="card">
        <div class="card-icon">⏱️</div>
        <h2>Salary to Hourly</h2>
        <p>Convert your annual salary into an hourly and monthly wage.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/uk-stamp-duty-calculator" class="card">
        <div class="card-icon">🇬🇧</div>
        <h2>UK Stamp Duty (FTB)</h2>
        <p>Calculate your SDLT bill instantly for UK properties.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/uk-lisa-calculator" class="card">
        <div class="card-icon">🇬🇧</div>
        <h2>UK Lifetime ISA (LISA)</h2>
        <p>Calculate your 25% government bonus and early withdrawal penalty.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/us-mortgage-calculator-pmi" class="card">
        <div class="card-icon">🏡</div>
        <h2>Mortgage with PMI</h2>
        <p>See your true payment, including Private Mortgage Insurance.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/dividend-reinvestment-calculator" class="card">
        <div class="card-icon">💰</div>
        <h2>Dividend Reinvestment (DRIP)</h2>
        <p>See how reinvesting dividends can compound your wealth.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/uk-student-loan-calculator" class="card">
        <div class="card-icon">🎓</div>
        <h2>UK Student Loan (Plan 2)</h2>
        <p>Estimate monthly repayments and take-home pay.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/us-401k-retirement-calculator" class="card">
        <div class="card-icon">💼</div>
        <h2>401(k) Retirement</h2>
