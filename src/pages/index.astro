        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/uk-income-tax-calculator" class="card">
        <div class="card-icon">💷</div>
        <h2>UK Income Tax</h2>
        <p>Calculate take-home pay after UK income tax and NI.</p>
        <span class="cta">Calculate &rarr;</span>
      </a>

      <a href="/tools/canada-mortgage-calculator" class="card">
        <div class="card-icon">🇨🇦</div>
        <h2>Canada Mortgage Calculator</h2>
