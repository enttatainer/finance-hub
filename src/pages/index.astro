    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('toolSearch');
    const cards = document.querySelectorAll('.card');
    const categoryTitles = document.querySelectorAll('.category-title');
    const noResults = document.getElementById('noResults');

    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase();
      let visibleCardsCount = 0;

      // 1. Filter Cards
      cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        if (text.includes(searchTerm)) {
          card.style.display = 'block';
          visibleCardsCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // 2. Handle "No Results" Message
      if (visibleCardsCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }

      // 3. Hide empty Category Titles
      categoryTitles.forEach(title => {
        let nextEl = title.nextElementSibling;
        let hasVisibleCards = false;
        
        // Loop through siblings until the next category title
        while (nextEl && !nextEl.classList.contains('category-title')) {
          if (nextEl.classList.contains('card') && nextEl.style.display !== 'none') {
            hasVisibleCards = true;
            break;
          }
          nextEl = nextEl.nextElementSibling;
        }
        
        title.style.display = hasVisibleCards || searchTerm === '' ? 'block' : 'none';
      });
    });
  });
</script>

<style>
  .container { max-width: 1000px; margin: 0 auto; padding: 64px 16px; }
  
  .hero { text-align: center; margin-bottom: 32px; }
  .hero h1 { font-size: 2.5rem; margin-bottom: 16px; color: #111827; font-weight: 800; letter-spacing: -0.025em; }
  .hero p { font-size: 1.25rem; color: #4b5563; }

  /* Search Bar Styling */
  .search-container {
    max-width: 600px;
    margin: 0 auto 48px auto;
    text-align: center;
  }

  #toolSearch {
    width: 100%;
    padding: 16px 24px;
    font-size: 1.1rem;
    border: 2px solid #e5e7eb;
    border-radius: 50px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  #toolSearch:focus {
    border-color: #2563eb;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
  }

  .no-results {
    margin-top: 24px;
    color: #6b7280;
    font-size: 1.1rem;
    font-weight: 500;
  }

  .hidden { display: none; }

  /* Grid & Categories */
  .grid { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 768px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1fr 1fr 1fr; } }
  
  .category-title {
    grid-column: 1 / -1;
    font-size: 1.5rem;
    color: #374151;
    margin-top: 32px;
    margin-bottom: 8px;
    padding-bottom: 12px;
    border-bottom: 2px solid #e5e7eb;
  }

  .card {
    display: block;
    background: white;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 1px solid #e5e7eb;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    border-color: #2563eb;
  }

  .card-icon { font-size: 2rem; margin-bottom: 16px; }
  .card h2 { font-size: 1.15rem; margin-top: 0; margin-bottom: 12px; color: #1f2937; }
  .card p { color: #6b7280; margin-bottom: 24px; line-height: 1.5; font-size: 0.95rem; }
  .cta { color: #2563eb; font-weight: 700; display: inline-block; font-size: 0.95rem; }
</style>

