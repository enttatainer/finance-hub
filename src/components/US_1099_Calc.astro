<div class="calc-box">
  <h2>Calculate Your 1099 Taxes</h2>
  
  <div class="input-group">
    <label>Net Profit (USD)</label>
    <input type="number" id="profit" placeholder="e.g. 50000" />
  </div>

  <!-- Added ID to the button, removed onclick -->
  <button id="calcBtn">Calculate Tax</button>

  <div id="result" class="hidden result-box">
    <p class="total">Estimated Total Tax: <strong id="totalTax"></strong></p>
    <p class="sub">Self-Employment Tax: <span id="seTax"></span></p>
    <p class="sub">Federal Income Tax: <span id="fedTax"></span></p>
  </div>
</div>

<script>
  // This is the modern way to handle clicks
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const profitInput = document.getElementById('profit') as HTMLInputElement;
    const profit = parseFloat(profitInput.value);
    
    if (isNaN(profit) || profit <= 0) {
      alert("Please enter a valid number.");
      return;
    }

    const seTax = profit * 0.9235 * 0.153;
    let taxableIncome = profit - (seTax / 2) - 14600;
    if (taxableIncome < 0) taxableIncome = 0;

    let fedTax = 0;
    if (taxableIncome <= 11600) {
      fedTax = taxableIncome * 0.10;
    } else if (taxableIncome <= 47150) {
      fedTax = 1160 + ((taxableIncome - 11600) * 0.12);
    } else {
      fedTax = 5426 + ((taxableIncome - 47150) * 0.22);
    }

    const total = seTax + fedTax;

    const totalEl = document.getElementById('totalTax');
    const seEl = document.getElementById('seTax');
    const fedEl = document.getElementById('fedTax');
    const resultBox = document.getElementById('result');

    if (totalEl && seEl && fedEl && resultBox) {
      totalEl.innerText = `$${total.toFixed(2)}`;
      seEl.innerText = `$${seTax.toFixed(2)}`;
      fedEl.innerText = `$${fedTax.toFixed(2)}`;
      resultBox.classList.remove('hidden');
    }
  });
</script>

<style>
  .calc-box {
    background: white;
    padding: 24px;
    border-radius: 8px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    max-width: 400px;
    margin: 32px auto;
  }
  .calc-box h2 { margin-top: 0; }
  .input-group { margin-bottom: 16px; }
  .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  button:hover { background: #1d4ed8; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; }
  .total { font-size: 18px; margin: 0 0 8px 0; }
  .sub { font-size: 14px; color: #4b5563; margin: 4px 0; }
</style>
