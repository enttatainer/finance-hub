<div class="calc-box">
  <h2>DRIP Calculator</h2>
  <div class="input-group">
    <label>Initial Investment ($)</label>
    <input type="number" id="initial" placeholder="e.g. 10000" />
  </div>
  <div class="input-group">
    <label>Monthly Contribution ($)</label>
    <input type="number" id="monthly" placeholder="e.g. 500" />
  </div>
  <div class="input-group">
    <label>Annual Dividend Yield (%)</label>
    <input type="number" id="yield" placeholder="e.g. 4" step="0.1" />
  </div>
  <div class="input-group">
    <label>Years Invested</label>
    <input type="number" id="years" placeholder="e.g. 20" />
  </div>
  <button id="calcBtn">Calculate Portfolio</button>
  <div id="result" class="hidden result-box">
    <p class="total">Future Portfolio Value: <strong id="finalValue"></strong></p>
    <p class="sub">Total Contributions: <span id="totalContrib"></span></p>
    <p class="sub">Total Dividends: <span id="totalDivs"></span></p>
  </div>
</div>
<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const p = parseFloat(document.getElementById('initial').value) || 0;
    const c = parseFloat(document.getElementById('monthly').value) || 0;
    const rate = parseFloat(document.getElementById('yield').value) / 100;
    const years = parseFloat(document.getElementById('years').value);

    if (isNaN(p) || isNaN(rate) || isNaN(years)) { alert("Fill all fields"); return; }

    let totalContrib = p;
    let portfolio = p;

    // Simple annual compounding with monthly additions
    for (let i = 0; i < years; i++) {
      portfolio = (portfolio + (c * 12)) * (1 + rate);
      totalContrib += (c * 12);
    }

    const totalDivs = portfolio - totalContrib;

    document.getElementById('finalValue').innerText = "$" + portfolio.toFixed(2);
    document.getElementById('totalContrib').innerText = "$" + totalContrib.toFixed(2);
    document.getElementById('totalDivs').innerText = "$" + totalDivs.toFixed(2);
    document.getElementById('result').classList.remove('hidden');
  });
</script>
<style>
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .input-group { margin-bottom: 16px; }
  .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; }
  .total { font-size: 18px; margin: 0 0 8px 0; }
  .sub { font-size: 14px; color: #4b5563; margin: 4px 0; }
</style>
