<div class="calc-box">
  <h2>Credit Card Payoff Calculator</h2>
  
  <div class="input-group">
    <label>Current Balance ($ / £)</label>
    <input type="number" id="balance" placeholder="e.g. 5000" />
  </div>
  <div class="input-group">
    <label>Annual Interest Rate (APR %)</label>
    <input type="number" id="apr" placeholder="e.g. 24.9" step="0.1" />
  </div>
  <div class="input-group">
    <label>Monthly Payment</label>
    <input type="number" id="payment" placeholder="e.g. 200" />
  </div>

  <button id="calcBtn">Calculate Payoff Time</button>

  <div id="result" class="hidden result-box">
    <p class="total">Time to Pay Off: <strong id="timeToPayoff"></strong></p>
    <p class="sub">Total Interest Paid: <span id="totalInterest" style="color: #dc2626;"></span></p>
    <p class="sub">Total Amount Paid: <span id="totalPaid"></span></p>
  </div>
</div>

<script>
  document.getElementById('calcBtn')?.addEventListener('click', () => {
    const balanceInput = parseFloat(document.getElementById('balance').value);
    const aprInput = parseFloat(document.getElementById('apr').value) / 100 / 12;
    const paymentInput = parseFloat(document.getElementById('payment').value);

    if (isNaN(balanceInput) || isNaN(aprInput) || isNaN(paymentInput) || paymentInput <= 0) {
      alert("Please enter valid numbers.");
      return;
    }

    let balance = balanceInput;
    let months = 0;
    let totalInterest = 0;

    while (balance > 0 && months < 1200) { // 100 year safety limit
      const interest = balance * aprInput;
      
      // If payment doesn't even cover the interest, they will never pay it off
      if (paymentInput <= interest) {
        alert("Your monthly payment is too low to cover the interest. You will never pay this off. Increase your payment.");
        return;
      }

      totalInterest += interest;
      balance = balance + interest - paymentInput;
      months++;
    }

    const years = Math.floor(months / 12);
    const remainingMonths = months % 12;
    
    let timeString = "";
    if (years > 0) timeString += years + " years, ";
    if (remainingMonths > 0) timeString += remainingMonths + " months";

    const totalPaid = balanceInput + totalInterest;

    const formatMoney = (num) => "$" + num.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});

    document.getElementById('timeToPayoff').innerText = timeString;
    document.getElementById('totalInterest').innerText = formatMoney(totalInterest);
    document.getElementById('totalPaid').innerText = formatMoney(totalPaid);
    
    document.getElementById('result').classList.remove('hidden');
  });
</script>

<style>
  .calc-box { background: white; padding: 24px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); max-width: 400px; margin: 32px auto; }
  .calc-box h2 { margin-top: 0; }
  .input-group { margin-bottom: 16px; }
  .input-group label { display: block; font-size: 14px; margin-bottom: 4px; }
  .input-group input { width: 100%; padding: 8px; border: 1px solid #d1d5db; border-radius: 4px; box-sizing: border-box; }
  button { width: 100%; padding: 10px; background: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
  button:hover { background: #1d4ed8; }
  .result-box { margin-top: 24px; padding: 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; }
  .hidden { display: none; }
  .total { font-size: 18px; margin: 0 0 8px 0; font-weight: bold; }
  .sub { font-size: 14px; color: #4b5563; margin: 6px 0; display: flex; justify-content: space-between; }
</style>
